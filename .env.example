# Resend — used by /api/contact to email leads to suessvilliano@gmail.com
# Get a key at https://resend.com (free tier: 100 emails/day, 3,000/month)
RESEND_API_KEY=

# Optional: verified sender. Defaults to Resend's onboarding sender.
# Once you verify a domain in Resend, set it like: "JAMAUR <hello@jamaurjohnson.com>"
RESEND_FROM="JAMAUR Site <onboarding@resend.dev>"

# GoHighLevel (LeadConnector) — used by /api/contact to sync leads into the CRM
# so email/SMS follow-up workflows can pick them up. Server-side only.
# Create a Private Integration Token: GHL → Settings → Private Integrations.
GHL_PIT_TOKEN=

# GHL sub-account / Location ID. Find it in the GHL app URL:
# app.gohighlevel.com/v2/location/<LOCATION_ID>/...
GHL_LOCATION_ID=

# Optional: override the GHL API version date header. Defaults to 2021-07-28.
GHL_API_VERSION=
